---
// SPDX-License-Identifier: MIT
// A paint chip, as a paint store's: the color, and under it a white strip with the part it went on, the color's
// name and the brand's number.
const { hex, part, name, code } = Astro.props;
---
<figure class="chip">
  <div class="chip__color" style={`background:${hex}`}></div>
  <figcaption class="chip__label">
    <span class="chip__part">{part}</span>
    <span class="chip__name">{name}</span>
    <span class="chip__code">{code}</span>
  </figcaption>
</figure>

<style>
  .chip {
    margin: 0;
    /* three in a row down to a phone's width */
    flex: 1 1 96px;
    max-width: 140px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(32 37 43 / 0.06);
  }
  .chip__color {
    height: 84px;
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.06);
  }
  .chip__label {
    display: grid;
    gap: 1px;
    padding: 9px 11px 11px;
    color: #20252b;
    line-height: 1.25;
  }
  .chip__part {
    font-size: 0.78rem;
    color: #5c6168;
  }
  .chip__name {
    font-weight: 650;
    font-size: 0.95rem;
  }
  .chip__code {
    font-size: 0.8rem;
    color: #5c6168;
    font-variant-numeric: tabular-nums;
  }
</style>
